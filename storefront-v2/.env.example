# The base URL of the Vetrina V2 API (the main Next.js app)
# Production: https URL of the Showroom deployment (see docs/deploy-vercel.md at repo root)
VETRINA_API_URL="http://localhost:3000"

# Shop slug to render (can also be resolved via hostname in multi-tenant setups)
SHOP_SLUG="your-shop-slug"

# Secret for on-demand revalidation (must match REVALIDATION_SECRET in the main app)
REVALIDATION_SECRET="your-secret"
