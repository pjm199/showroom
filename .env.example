# Database (required for Prisma)
# - DATABASE_URL: V1 app (Supabase pooler is fine)
# - DIRECT_URL: optional, used only for Prisma migrations in CI/build to avoid pooler client limits
# - DATABASE_URL_V2: V2 schema — can point to the same Postgres instance (all tables are prefixed v2_)
# Production checklist (Vercel + managed Postgres): docs/deploy-vercel.md
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DATABASE_URL_V2="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Optional — only if using a connection pooler for DATABASE_URL_V2 (e.g. Supabase pooler on Vercel).
# Use the direct Postgres URL for Prisma migrate; same as DATABASE_URL_V2 for local dev.
# DIRECT_URL_V2="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth (required for NextAuth). Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-at-least-32-chars"

# B2B client portal sessions (defaults to AUTH_SECRET if unset)
# B2B_SESSION_SECRET="your-b2b-session-secret"

# Optional: set in production (e.g. https://yourdomain.com)
# NEXTAUTH_URL="http://localhost:3000"

# V2 feature flag — set to "true" to enable V2 dashboard for all shops in dev
# In production, use V2_ENABLED_SHOPS=shopId1,shopId2 (or "*" for all)
# V2_ENABLED="true"
# V2_ENABLED_SHOPS="*"

# Storefront on-demand revalidation secret (must match storefront-v2 REVALIDATION_SECRET)
# REVALIDATION_SECRET="your-secret-here"

# Public URL for the storefront-v2 app (used to build preview URLs)
# Production: set to the deployed storefront origin (see docs/deploy-vercel.md)
# NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3001"

# Image uploads (Vercel Blob). Get token at vercel.com/dashboard/stores
# Without this, merchants can still set logo via URL in profile.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
