# Database (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth (required for NextAuth). Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-at-least-32-chars"

# Optional: set in production (e.g. https://yourdomain.com)
# NEXTAUTH_URL="http://localhost:3000"

# Image uploads (Vercel Blob). Get token at vercel.com/dashboard/stores
# Without this, merchants can still set logo via URL in profile.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
